    "review::.::holistic::logic_clarity::misleading_noop_timestamp_lambda": {
      "issue_id": "review::.::holistic::logic_clarity::misleading_noop_timestamp_lambda",
      "kind": "permanent",
      "reason": null,
      "note": "Deferred to the follow-up PR, group defer-to-followup-pr/api-naming. This is a user-visible breaking change, not a local cleanup: _LAMBDA_REGISTRY names are convert_lambda catalogue vocabulary, and extension_config.py:40-42 lets users override sensors from their own configuration. utils.py:236-248 resolves an unknown name by logging a warning and deleting the key, so a renamed lambda silently publishes a raw Unix epoch to Home Assistant instead of an ISO timestamp. Needs a deprecation alias and its own PR headline.",
      "attestation": "I have reviewed this triage skip against the code and I am not gaming the score by suppressing a real defect.",
