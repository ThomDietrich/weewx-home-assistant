    "review::.::holistic::cross_module_architecture::submodules_import_via_package_init": {
      "id": "review::.::holistic::cross_module_architecture::submodules_import_via_package_init",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Sibling modules import each other through the package __init__ facade, creating an import cycle that depends on import order",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/weewx_ha/__init__.py",
          "src/weewx_ha/controller.py",
          "src/weewx_ha/state_publisher.py",
          "src/weewx_ha/models/extension_config.py",
          "src/weewx_ha/config_publisher.py"
        ],
        "evidence": [
          "controller.py: 'from . import ConfigPublisher, PacketPreprocessor, StatePublisher'",
          "state_publisher.py: 'from . import ConfigPublisher, UnitSystem'",
          "models/extension_config.py: 'from .. import UnitSystem' and 'from . import MQTTConfig, StationInfo'",
          "__init__.py wraps imports in 'isort: off' specifically to prevent circular imports; config_publisher.py:160 has a function-level import of .utils that is already imported at module top"
        ],
        "suggestion": "Import from defining modules directly (from .config_publisher import ConfigPublisher, from .utils import UnitSystem, from .models.mqtt_config import ...). Keep __init__ as a pure re-export facade nothing inside the package imports from, then remove the isort-off guard and the redundant deferred import.",
        "reasoning": "",
        "summary_hash": "69b906ae"
      },
      "status": "wontfix",
      "note": "defer-to-followup-pr/import-topology canonical entry - break the seven-file package-root cycle and re-enable isort there, not in a four-defect bugfix PR",
