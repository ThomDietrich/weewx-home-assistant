    "review::.::holistic::contract_coherence::key_config_accessor_inconsistent_copy_semantics": {
      "id": "review::.::holistic::contract_coherence::key_config_accessor_inconsistent_copy_semantics",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "low",
      "summary": "get_key_config returns defensive copies but sibling get_key_config_dict returns the live shared cache, with an inline import to reach it",
      "detail": {
        "holistic": true,
        "dimension": "contract_coherence",
        "related_files": [
          "src/weewx_ha/utils.py",
          "src/weewx_ha/config_publisher.py",
          "src/weewx_ha/__init__.py"
        ],
        "evidence": [
          "get_key_config deep-copies 'so callers can mutate the result without corrupting the shared cache'; get_key_config_dict hands out the cache itself and is absent from the package __all__.",
          "config_publisher._discover_derived_sensors does 'from .utils import get_key_config_dict' inside the method and iterates it; safety depends on that caller not mutating.",
          "StatePublisher/Controller import UnitSystem/ConfigPublisher via 'from . import ...' while ConfigPublisher imports directly from .utils; models/extension_config.py imports 'from .. import UnitSystem', coupling submodules to the facade's import order."
        ],
        "suggestion": "Return a read-only view (MappingProxyType) or a copy from get_key_config_dict, move its import to module level, and have submodules import from the defining module rather than the package __init__.",
        "reasoning": "",
        "summary_hash": "d0256160"
      },
      "status": "wontfix",
      "note": "not-worth-it - no caller mutates the shared mapping and a MappingProxyType would break the existing list(...).items() snapshot idiom, so only its one-line import half is worth acting on and that is owned by dead-code-and-residue-deletion",
