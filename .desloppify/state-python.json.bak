    "review::.::holistic::type_safety::dead_none_guard_unit_system": {
      "id": "review::.::holistic::type_safety::dead_none_guard_unit_system",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "is-not-None guards on a non-Optional unit_system",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "src/weewx_ha/config_publisher.py",
          "src/weewx_ha/state_publisher.py"
        ],
        "evidence": [
          "`if self.unit_system is not None:` while the parameter is typed `UnitSystem = UnitSystem.METRICWX`"
        ],
        "suggestion": "Remove the guards or make the type Optional if None is a real input.",
        "reasoning": "",
        "summary_hash": "223205db"
      },
      "status": "fixed",
      "note": "Deleted the two unit_system None guards (confirmed unreachable: non-Optional pydantic field with a default, both constructors non-Optional, both call sites pass self.config.unit_system, coverage reports the None arm as a never-taken partial branch), the username/password guard before username_pw_set (username min_length=1 and a validator rejecting an empty password), and the duplicated function-scope get_key_config_dict import, which joined the module-level import from the same module. The three RuntimeError guards in utils.py are deliberately kept: they narrow dict | None for mypy after _ensure_loaded, and removing them takes mypy from one pre-existing error to four. 83 passed, pre-commit clean, mypy at baseline.",
      "first_seen": "2026-11-10T11:08:54+00:00",
      "last_seen": "2026-11-10T11:08:54+00:00",
