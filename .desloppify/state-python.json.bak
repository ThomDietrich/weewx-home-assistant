      "id": "review::.::holistic::naming_quality::camelcase_local_in_preprocessor",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "low",
      "summary": "Local variable txBatteryStatus is camelCase in an otherwise snake_case module",
      "detail": {
        "holistic": true,
        "dimension": "naming_quality",
        "related_files": [
          "src/weewx_ha/preprocessor.py"
        ],
        "evidence": [
          "txBatteryStatus = packet[\"txBatteryStatus\"] shadows the WeeWX key name as a local variable"
        ],
        "suggestion": "Rename the local to tx_battery_bitmap.",
        "reasoning": "",
        "summary_hash": "a5639216"
      },
      "status": "fixed",
      "note": "Shift the bit down instead of masking it in place, so all eight fields publish 0/1 against the catalogue's payload_on: 1; a None bitmap now removes the key and publishes nothing rather than raising TypeError on a worker thread whose completion handler would discard the whole packet; no-op __init__ and entry debug logs deleted. tests/test_preprocessor.py asserts against the payloads get_key_config actually declares (16 tests, 11 failing against the old code, the one that passed was bit 0).",
      "first_seen": "2026-11-10T11:08:54+00:00",
      "last_seen": "2026-11-10T11:08:54+00:00",
      "resolved_at": "2026-11-10T12:25:37+00:00",
