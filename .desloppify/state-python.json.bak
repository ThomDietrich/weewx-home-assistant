    "review::.::holistic::cross_module_architecture::global_language_state_coordinates_modules": {
      "id": "review::.::holistic::cross_module_architecture::global_language_state_coordinates_modules",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Language/override configuration flows through module-level globals and lazy caches, making utils behavior depend on Controller call order",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/weewx_ha/locale_loader.py",
          "src/weewx_ha/utils.py",
          "src/weewx_ha/controller.py"
        ],
        "evidence": [
          "locale_loader._current_language and _config_overrides are mutated via set_language/set_config_overrides from Controller.__init__",
          "utils._ENUM_MAPS/_UNIT_METADATA/_SENSORS_YAML/_KEY_CONFIG are lazily populated on first access and never invalidated, so changing language or overrides after first use silently has no effect",
          "Tests and any second Controller instance share this process-wide state"
        ],
        "suggestion": "Pass language and overrides explicitly into a small locale/catalog object built once by Controller and handed to the publishers, or at least provide a single reset function that clears the locale and utils caches together.",
        "reasoning": "",
        "summary_hash": "af356790"
      },
      "status": "fixed",
      "note": "set_language/set_config_overrides now call utils.reset_caches through a function-scope import (utils imports locale_loader, so a module-scope import back would be circular); _KEY_CONFIG declared beside the other three caches; tests/test_locale_cache.py pins language, overrides and clearing both, all three failing without the fix; reset_locale_state is now one autouse fixture in tests/conftest.py instead of seven copies, and the unused imports are gone. 83 passed, mypy at its one pre-existing baseline error.",
      "first_seen": "2026-11-10T11:08:54+00:00",
      "last_seen": "2026-11-10T11:08:54+00:00",
      "resolved_at": "2026-11-10T12:30:53+00:00",
      "reopen_count": 0,
      "work_item_kind": "review_defect",
      "issue_kind": "review_defect",
      "origin": "review_import",
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually set_language/set_config_overrides now call utils.reset_caches through a function-scope import (utils imports locale_loader, so a module-scope import back would be circular); _KEY_CONFIG declared beside the other three caches; tests/test_locale_cache.py pins language, overrides and clearing both, all three failing without the fix; reset_locale_state is now one autouse fixture in tests/conftest.py instead of seven copies, and the unused imports are gone. 83 passed, mypy at its one pre-existing baseline error. and I am not gaming the score.",
        "attested_at": "2026-11-10T12:30:53+00:00",
