    "review::.::holistic::logic_clarity::battery_bitmap_payload_mismatch": {
      "id": "review::.::holistic::logic_clarity::battery_bitmap_payload_mismatch",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "txBatteryStatus bits are published as 2**i values but binary sensors only treat 1 as ON, so channels 2-7 can never report low battery",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "src/weewx_ha/preprocessor.py",
          "src/weewx_ha/locales/sensors.yaml"
        ],
        "evidence": [
          "preprocessor.py:35 `packet[field] = txBatteryStatus & (1 << i)`",
          "sensors.yaml batteryStatusChannel/ISS payload_on: 1, payload_off: 0",
          "Verified: input 128 gives batteryStatusChannel7 == 128"
        ],
        "suggestion": "Normalize to 0/1: `packet[field] = (txBatteryStatus >> i) & 1`, and skip when txBatteryStatus is None.",
        "reasoning": "",
        "summary_hash": "c5824dfd"
      },
      "status": "fixed",
      "note": "Shift the bit down instead of masking it in place, so all eight fields publish 0/1 against the catalogue's payload_on: 1; a None bitmap now removes the key and publishes nothing rather than raising TypeError on a worker thread whose completion handler would discard the whole packet; no-op __init__ and entry debug logs deleted. tests/test_preprocessor.py asserts against the payloads get_key_config actually declares (16 tests, 11 failing against the old code, the one that passed was bit 0).",
      "first_seen": "2026-11-10T11:08:54+00:00",
      "last_seen": "2026-11-10T11:08:54+00:00",
      "resolved_at": "2026-11-10T12:25:37+00:00",
      "reopen_count": 0,
      "work_item_kind": "review_defect",
      "issue_kind": "review_defect",
      "origin": "review_import",
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Shift the bit down instead of masking it in place, so all eight fields publish 0/1 against the catalogue's payload_on: 1; a None bitmap now removes the key and publishes nothing rather than raising TypeError on a worker thread whose completion handler would discard the whole packet; no-op __init__ and entry debug logs deleted. tests/test_preprocessor.py asserts against the payloads get_key_config actually declares (16 tests, 11 failing against the old code, the one that passed was bit 0). and I am not gaming the score.",
        "attested_at": "2026-11-10T12:25:37+00:00",
        "scan_verified": false
      }
    },
