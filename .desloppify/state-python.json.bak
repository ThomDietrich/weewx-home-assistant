      "work_item_kind": "review_defect",
      "issue_kind": "review_defect",
      "origin": "review_import",
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Shift the bit down instead of masking it in place, so all eight fields publish 0/1 against the catalogue's payload_on: 1; a None bitmap now removes the key and publishes nothing rather than raising TypeError on a worker thread whose completion handler would discard the whole packet; no-op __init__ and entry debug logs deleted. tests/test_preprocessor.py asserts against the payloads get_key_config actually declares (16 tests, 11 failing against the old code, the one that passed was bit 0). and I am not gaming the score.",
        "attested_at": "2026-11-10T12:25:37+00:00",
        "scan_verified": false
      }
    },
